{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=54322;Database=postgres;Username=postgres;Password=postgres"
  },
  "Supabase": {
    "Url": "http://127.0.0.1:54321",
    "Key": "your-anon-key-here"
  },
  "Jwt": {
    "Secret": "development-secret-key-minimum-32-characters-for-testing-only",
    "Issuer": "FlowertrackApi",
    "Audience": "FlowertrackClient",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
